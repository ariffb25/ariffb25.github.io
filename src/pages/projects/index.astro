      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
    </a>
    <a href="/cv" class="flex items-center justify-center size-9 rounded-full bg-background text-muted-foreground hover:text-foreground hover:bg-muted border border-border transition-colors" title="CV">
      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    </a>
    <div class="w-px h-6 bg-border"></div>
    <button @click="$store.global.toggleLang()" class="flex items-center justify-center size-9 rounded-full bg-background text-muted-foreground hover:text-foreground hover:bg-muted border border-border transition-colors text-xs font-bold" title="Bahasa" aria-label="Toggle language">
      <span x-text="$store.global.lang.toUpperCase()">EN</span>
    </button>
    <button @click="$store.global.toggleDark()" class="flex items-center justify-center size-9 rounded-full bg-background text-muted-foreground hover:text-foreground hover:bg-muted border border-border transition-colors" title="Tema" aria-label="Toggle dark mode">
      <svg x-show="!$store.global.dark" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      <svg x-show="$store.global.dark" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
    </button>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('img[loading="lazy"]').forEach((img) => {
      img.addEventListener('error', () => {
        img.style.display = 'none';
        const skeleton = document.createElement('div');
        skeleton.className = 'w-full h-full min-h-[64px] bg-muted/80 flex flex-col items-center justify-center text-muted-foreground gap-1 border border-border/50 rounded-lg animate-pulse p-2';
        skeleton.innerHTML = '<svg class="size-6 text-muted-foreground/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg><span class="text-[9px] uppercase font-mono tracking-wider text-muted-foreground/50">No Image</span>';
        img.parentElement?.appendChild(skeleton);
      });
    });
  });
</script>

</body>
</html>